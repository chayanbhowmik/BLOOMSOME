rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['super_admin', 'manager', 'artisan'];
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepage/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read, create, update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if isAdmin() || resource.data.status == 'approved';
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wishlists/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /carts/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /orders/{orderId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid || isAdmin();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}